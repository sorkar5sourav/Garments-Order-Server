# Garments Order Server — Environment Configuration
# Copy this file to .env and fill in your values
# All variables listed are required unless marked as Optional

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
TRUST_PROXY=0

# ============================================
# Database Configuration
# MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# ============================================
DB_USER=your_mongodb_username
DB_PASSWORD=your_mongodb_password
# Connection string format: mongodb+srv://<user>:<password>@<cluster>.jskgf2c.mongodb.net/?appName=<app>

# ============================================
# Firebase Authentication
# Get from: Firebase Console → Project Settings → Service Accounts
# Steps:
# 1. Go to Firebase Console → Your Project
# 2. Click Settings (gear icon) → Service Accounts
# 3. Click "Generate New Private Key"
# 4. Base64-encode the JSON file and paste below
# 
# Bash command to encode:
# base64 -w 0 < serviceAccountKey.json > encoded.txt
# ============================================
FB_SERVICE_KEY=your_base64_encoded_firebase_service_account_key

# ============================================
# Stripe Payment Integration
# Get keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_* for development, sk_live_* for production
# ============================================
STRIPE_SECRET=sk_test_your_stripe_secret_key

# ============================================
# CORS & Deployment Configuration
# ============================================
# Comma-separated list of allowed origins (no trailing slashes)
# Example: http://localhost:5173,http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://garments-order-tracker.web.app

# Domain used for Stripe success/cancel redirects
SITE_DOMAIN=http://localhost:3000

# ============================================
# Rate Limiting Configuration
# ============================================
# Time window for rate limiting in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per window
# Note: Dev defaults to 2000 if NODE_ENV=development, 100 for production
RATE_LIMIT_MAX=100

# Comma-separated list of IPs to whitelist from rate limiting (optional)
# Example: 127.0.0.1,192.168.1.1
RATE_LIMIT_WHITELIST=

# ============================================
# Optional: Additional Configuration
# ============================================
# Webhook secret for Stripe (if using webhook verification)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email configuration (if implementing email notifications)
# SENDGRID_API_KEY=SG.your_sendgrid_key
# ADMIN_EMAIL=admin@example.com
